# ─── Sage Team Environment Variables ─────────────────────────────────────────

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: Default Claude model (default: claude-sonnet-4-20250514)
# SAGE_MODEL=claude-sonnet-4-20250514

# Optional: Company name (default: Sage Team)
# SAGE_COMPANY_NAME=My AI Company

# Optional: Company mission
# SAGE_MISSION=Build great software autonomously

# Optional: Max concurrent agents (default: 11)
# SAGE_MAX_AGENTS=11

# Optional: Sprint duration in days (default: 14)
# SAGE_SPRINT_DAYS=14

# Optional: Enable/disable visual dashboard (default: true)
# SAGE_VISUAL=true

# Optional: Project path for screenshots and artifacts
# SAGE_PROJECT_PATH=.
