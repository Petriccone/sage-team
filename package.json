{
  "name": "sage-team",
  "version": "2.0.0",
  "description": "AI-powered autonomous agent team with real-time 2D visual office simulation. Watch your AI company work.",
  "main": "dist/index.js",
  "bin": {
    "sage-team": "dist/cli.js",
    "sage": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "postinstall": "npx playwright install chromium || echo '⚠️  Chromium install failed. Run: npx playwright install chromium'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "autonomous",
    "multi-agent",
    "visualization",
    "terminal-ui",
    "company-simulation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@playwright/mcp": "^0.0.68",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "conf": "^10.2.0",
    "eventemitter3": "^5.0.1",
    "figlet": "^1.8.0",
    "nanoid": "^3.3.7",
    "ora": "^5.4.1",
    "playwright-core": "^1.59.0-alpha-1771104257000"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
